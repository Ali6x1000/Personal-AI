# Local development only. On LiveKit Cloud, LIVEKIT_* are injected and the rest are set as secrets.
LIVEKIT_URL=wss://alijr-iqw6s4i4.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Same Gemini API key as GOOGLE_GENERATIVE_AI_API_KEY on Vercel.
GOOGLE_API_KEY=

# Portfolio that serves /api/alijr/tools, and the shared secret it expects.
ALIJR_SITE_URL=http://localhost:3000
ALIJR_AGENT_SECRET=

# Optional
# LIVEKIT_AGENT_NAME=alijr-voice
# ALIJR_VOICE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# ALIJR_VOICE=Puck
# ALIJR_MAX_SESSION_SECONDS=600
